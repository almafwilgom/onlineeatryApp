# =============================
# Online Eatery — .gitignore
# =============================

# Dependencies
node_modules/
**/node_modules/

# Environment variables — NEVER commit these
.env
**/.env
!.env.example
**/.env.example

# Build output
dist/
build/
**/dist/
**/build/

# Vite
.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Coverage
coverage/
